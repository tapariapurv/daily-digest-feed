# Supabase Postgres via the transaction pooler (port 6543), as the restricted digest_app role
DATABASE_URL=postgresql://digest_app.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Google AI Studio key (free tier)
GEMINI_API_KEY=
# Optional: comma-separated model fallback chain
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
# Initial passcode for the site (can be changed later in Settings)
APP_PASSCODE=
# Random 32+ byte string used to sign session cookies
AUTH_SECRET=
# Vercel sends this as a Bearer token to the cron endpoint
CRON_SECRET=
