# Firebase service-account JSON (one line). Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=
# Shared Google AI Studio key (free tier); readers can add their own in Settings
GEMINI_API_KEY=
# Optional: comma-separated model fallback chain
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
# Encrypts readers' own API keys at rest
AUTH_SECRET=

# Public URL used in emails
SITE_URL=https://your-app.vercel.app
# Optional: the Gmail account the Apps Script scheduler runs as. It receives newsletters
# (plus-addresses) and sends editions; no password needed.
MAIL_ACCOUNT=
