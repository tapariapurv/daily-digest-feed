# Supabase Postgres via the transaction pooler, as the restricted digest_app role
DATABASE_URL=postgresql://digest_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase Auth (public values)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Shared Google AI Studio key (free tier); readers can add their own in Settings
GEMINI_API_KEY=
# Optional: comma-separated model fallback chain
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite
# Encrypts readers' own API keys at rest
AUTH_SECRET=
# Bearer token for /api/cron/tick (Vercel Cron and Supabase pg_cron)
CRON_SECRET=
# Public URL used in emails
SITE_URL=https://your-app.vercel.app
# Optional email delivery (Gmail: smtp.gmail.com, 465, your address, a 16-char app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
